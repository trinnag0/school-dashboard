# Prisma Database
DATABASE_URL="file:./dev.db"

# Server Port
PORT=3000

# Twilio Credentials (Required for Real SMS/WhatsApp)
# Get these from your Twilio Console (twilio.com)
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1234567890"         # Your Twilio SMS number
TWILIO_WHATSAPP_NUMBER="+14155238886"     # Twilio Sandbox or Approved WhatsApp number
